table Sales
	lineageTag: f17bb554-9e64-5ff5-9a22-c3a0c0f992ea

	measure Revenue = SUM(Sales[price])
		formatString: "R$ "#,##0
		lineageTag: 5b0ef173-dbb6-5d45-865e-70fb289fddf0

	measure Orders = DISTINCTCOUNT(Sales[order_id])
		formatString: #,##0
		lineageTag: a3921e79-50f3-5739-8372-0015844e3495

	measure Customers = DISTINCTCOUNT(Sales[customer_unique_id])
		formatString: #,##0
		lineageTag: d78b2c64-00fe-5746-9a02-ff1edb693762

	measure 'Avg Order Value' = DIVIDE([Revenue], [Orders])
		formatString: "R$ "#,##0.00
		lineageTag: 512c3223-86e0-5662-be7b-d4b059314c9b

	measure Freight = SUM(Sales[freight_value])
		formatString: "R$ "#,##0
		lineageTag: 5b7d972f-c016-55a5-b416-9d5e5f78674f

	measure 'Late %' = DIVIDE(CALCULATE(DISTINCTCOUNT(Sales[order_id]), Sales[is_late] = 1), [Orders])
		formatString: 0.0%
		lineageTag: 1102c59e-65a9-5cc9-b1e3-bdbfc5666ed6

	measure 'Avg Delivery Days' = AVERAGEX(VALUES(Sales[order_id]), CALCULATE(MAX(Sales[delivery_days])))
		formatString: 0.0
		lineageTag: 989d06cf-dbcf-5248-adb8-8e6d2db85ac2

