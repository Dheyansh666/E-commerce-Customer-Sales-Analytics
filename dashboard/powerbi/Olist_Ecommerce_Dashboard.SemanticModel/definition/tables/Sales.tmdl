		annotation SummarizationSetBy = User

	column 'Top 10 State'
		dataType: string
		lineageTag: f889ed82-e2ee-57cd-9303-361d88da27e7
		summarizeBy: none
		sourceColumn: Top 10 State

		annotation SummarizationSetBy = User

	partition Sales = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "sales_clean.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Promoted, {"order_id", "customer_unique_id", "customer_state", "purchase_time", "month", "product_id", "seller_id", "price", "freight_value", "category", "delivery_days", "is_late"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"order_id", type text}, {"customer_unique_id", type text}, {"customer_state", type text}, {"purchase_time", type datetime}, {"month", type text}, {"product_id", type text}, {"seller_id", type text}, {"price", type number}, {"freight_value", type number}, {"category", type text}, {"delivery_days", Int64.Type}, {"is_late", Int64.Type}}, "en-US"),
				    TopCats = List.Buffer(List.FirstN(Table.Sort(Table.Group(Typed, {"category"}, {{"rev", each List.Sum([price]), type number}}), {{"rev", Order.Descending}})[category], 10)),
				    TopStates = List.Buffer(List.FirstN(Table.Sort(Table.Group(Typed, {"customer_state"}, {{"rev", each List.Sum([price]), type number}}), {{"rev", Order.Descending}})[customer_state], 10)),
				    Base = Typed,
				    Added0 = Table.AddColumn(Base, "Top 10 Category", each if List.Contains(TopCats, [category]) then "Yes" else "No", type text),
				    Added1 = Table.AddColumn(Added0, "Top 10 State", each if List.Contains(TopStates, [customer_state]) then "Yes" else "No", type text)
				in
				    Added1

	annotation PBI_ResultType = Table
